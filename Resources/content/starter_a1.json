  {
   "spelling": "ä",
   "say": {
    "tr": "Açık bir „e“ gibi.",
    "en": "Like the \"e\" in \"bed\"."
   },
   "examples": [
    "Käse",
    "Mädchen"
   ]
  },
  {
   "spelling": "ö",
   "say": {
    "tr": "Türkçedeki „ö“ gibi.",
    "en": "Round your lips and say \"e\"."
   },
   "examples": [
    "schön",
    "hören"
   ]
  },
  {
   "spelling": "ü",
   "say": {
    "tr": "Türkçedeki „ü“ gibi.",
    "en": "Round your lips and say \"i\"."
   },
   "examples": [
    "Tür",
    "müde"
   ]
  },
  {
   "spelling": "ß",
   "say": {
    "tr": "Çift „s“ gibi: ss.",
    "en": "A sharp \"ss\"."
   },
   "examples": [
    "Straße",
    "groß"
   ]
  },
  {
   "spelling": "ei",
   "say": {
    "tr": "„ay“ diye okunur: drei → dray.",
    "en": "Says \"eye\": drei → \"dry\"."
   },
   "examples": [
    "drei",
    "mein",
    "Ei"
   ]
  },
  {
   "spelling": "ie",
   "say": {
    "tr": "Uzun „i“: Liebe → liibe.",
    "en": "A long \"ee\": Liebe."
   },
   "examples": [
    "Liebe",
    "vier",
    "sie"
   ]
  },
  {
   "spelling": "eu / äu",
   "say": {
    "tr": "„oy“ diye okunur: heute → hoyte.",
    "en": "Says \"oy\": heute → \"hoy-te\"."
   },
   "examples": [
    "heute",
    "neu",
    "Häuser"
   ]
  },
  {
   "spelling": "au",
   "say": {
    "tr": "„av“ diye okunur: Haus → havs.",
    "en": "Says \"ow\" as in \"house\"."
   },
   "examples": [
    "Haus",
    "Frau"
   ]
  },
  {
   "spelling": "sch",
   "say": {
    "tr": "„ş“ diye okunur.",
    "en": "Says \"sh\"."
   },
   "examples": [
    "Schule",
    "Tisch"
   ]
  },
  {
   "spelling": "ch",
   "say": {
    "tr": "a, o, u’dan sonra boğazdan hırıltılı „h“ (Buch); başka yerlerde yumuşak „h“ (ich).",
    "en": "After a, o, u a throaty sound (Buch); elsewhere a soft hiss (ich)."
   },
   "examples": [
    "Buch",
    "ich",
    "Milch"
   ]
  },
  {
   "spelling": "st / sp",
   "say": {
    "tr": "Kelime başında „şt / şp“: Straße → ştrase.",
    "en": "At the start of a word \"sht / shp\"."
   },
   "examples": [
    "Straße",
    "sprechen"
   ]
  },
  {
   "spelling": "z",
   "say": {
    "tr": "„ts“ diye okunur: Zug → tsuk.",
    "en": "Says \"ts\": Zug → \"tsook\"."
   },
   "examples": [
    "Zug",
    "zehn"
   ]
  },
  {
   "spelling": "v",
   "say": {
    "tr": "Çoğunlukla „f“ diye okunur: Vater → fater.",
    "en": "Usually says \"f\": Vater."
   },
   "examples": [
    "Vater",
    "viel"
   ]
  },
  {
   "spelling": "w",
   "say": {
    "tr": "„v“ diye okunur: Wasser → vasser.",
    "en": "Says \"v\": Wasser."
   },
   "examples": [
    "Wasser",
    "wo"
   ]
  },
  {
   "spelling": "j",
   "say": {
    "tr": "„y“ diye okunur: ja → ya.",
    "en": "Says \"y\": ja → \"yah\"."
   },
   "examples": [
    "ja",
    "Jahr"
   ]
  },
  {
   "spelling": "h",
   "say": {
    "tr": "Ünlüden sonra okunmaz, ünlüyü uzatır: Uhr → uur.",
    "en": "After a vowel it is silent and makes the vowel long."
   },
   "examples": [
    "Uhr",
    "gehen"
   ]
  },
  {
   "spelling": "-er",
   "say": {
    "tr": "Kelime sonunda hafif bir „a“ gibi: Mutter → mutta.",
    "en": "At the end of a word like a soft \"a\"."
   },
   "examples": [
    "Mutter",
    "Lehrer"
   ]
  },
  {
   "spelling": "-ig",
   "say": {
