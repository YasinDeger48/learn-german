  {
   "id": "a1-song-04",
   "title": "Zahlen, Zahlen",
   "title_tr": "Sayılar, sayılar",
   "title_en": "Numbers, numbers",
   "bpm": 108,
   "mood": "happy",
   "lines": [
    {
     "part": "intro",
     "who": "Lina",
     "de": "Zähl mit mir, eins, zwei!",
     "tr": "Benimle say, bir, iki!",
     "en": "Count with me, one, two!"
    },
    {
     "part": "call",
     "who": "Lina",
     "de": "Wie viele Äpfel siehst du?",
     "tr": "Kaç elma görüyorsun?",
     "en": "How many apples do you see?"
    },
    {
     "part": "answer",
     "who": "Du",
     "de": "Drei Äpfel!",
     "tr": "Üç elma!",
     "en": "Three apples!"
    },
    {
     "part": "chorus",
     "who": "Alle",
     "de": "Eins, zwei, drei, wir zählen!",
     "tr": "Bir, iki, üç, sayıyoruz!",
     "en": "One, two, three, we count!"
    },
    {
     "part": "chorus",
     "who": "Alle",
     "de": "Eins, zwei, drei, wir zählen!",
     "tr": "Bir, iki, üç, sayıyoruz!",
     "en": "One, two, three, we count!"
    },
    {
     "part": "verse",
     "who": "Lina",
     "de": "Drei rote Äpfel liegen hier.",
     "tr": "Üç kırmızı elma burada duruyor.",
     "en": "Four red apples are lying here."
    },
    {
     "part": "call",
     "who": "Lina",
     "de": "Und wie viele Bananen?",
     "tr": "Peki kaç muz?",
     "en": "And how many bananas?"
    },
    {
     "part": "answer",
     "who": "Du",
     "de": "Fünf Bananen!",
     "tr": "Beş muz!",
     "en": "Five bananas!"
    },
    {
     "part": "verse",
     "who": "Lina",
     "de": "Sechs Bananen rutschen weg.",
     "tr": "Altı muz kayıp gidiyor.",
     "en": "Six bananas slide away."
    },
    {
     "part": "call",
     "who": "Lina",
     "de": "Wie viele liegen dort?",
     "tr": "Orada kaç tane duruyor?",
     "en": "How many are lying there?"
    },
    {
     "part": "answer",
     "who": "Du",
     "de": "Sieben Bananen!",
     "tr": "Yedi muz!",
     "en": "Seven bananas!"
    },
    {
     "part": "chorus",
     "who": "Alle",
     "de": "Eins, zwei, drei, wir zählen!",
     "tr": "Bir, iki, üç, sayıyoruz!",
     "en": "One, two, three, we count!"
    },
    {
     "part": "chorus",
     "who": "Alle",
     "de": "Eins, zwei, drei, wir zählen!",
     "tr": "Bir, iki, üç, sayıyoruz!",
     "en": "One, two, three, we count!"
    },
    {
     "part": "verse",
     "who": "Lina",
     "de": "Acht, neun, zehn: Der Hund zählt.",
     "tr": "Sekiz, dokuz, on: Köpek sayıyor.",
     "en": "Eight, nine, ten: The dog counts."
    },
    {
     "part": "call",
     "who": "Lina",
     "de": "Wie viele Schuhe hat er?",
     "tr": "Kaç ayakkabısı var?",
     "en": "How many shoes does he have?"
    },
    {
     "part": "answer",
     "who": "Du",
     "de": "Zwei Schuhe!",
     "tr": "İki ayakkabı!",
     "en": "Two shoes!"
    },
    {
     "part": "verse",
     "who": "Lina",
     "de": "Elf bis zwanzig bellt er laut.",
     "tr": "On birden yirmiye kadar yüksek sesle havlıyor.",
     "en": "He barks loudly from eleven to twenty."
    },
    {
     "part": "call",
     "who": "Lina",
     "de": "Kann der Hund gut zählen?",
     "tr": "Köpek iyi sayabiliyor mu?",
     "en": "Can the dog count well?"
    },
    {
     "part": "answer",
     "who": "Du",
     "de": "Ja, bis zwanzig!",
     "tr": "Evet, yirmiye kadar!",
     "en": "Yes, up to twenty!"
    },
    {
     "part": "chorus",
     "who": "Alle",
     "de": "Eins, zwei, drei, wir zählen!",
     "tr": "Bir, iki, üç, sayıyoruz!",
     "en": "One, two, three, we count!"
    },
    {
     "part": "outro",
     "who": "Lina",
     "de": "Der Hund zählt seine Pfoten!",
     "tr": "Köpek patilerini sayıyor!",
     "en": "The dog counts his paws!"
    }
