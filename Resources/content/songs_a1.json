  {
   "id": "a1-song-05",
   "title": "Die Wochentage",
   "title_tr": "Haftanın günleri",
   "title_en": "The days of the week",
   "bpm": 96,
   "mood": "funny",
   "lines": [
    {
     "part": "intro",
     "who": "Lina",
     "de": "Sieben Tage, komm, wir gehen!",
     "tr": "Yedi gün, haydi gidelim!",
     "en": "Seven days, come, let's go!"
    },
    {
     "part": "call",
     "who": "Lina",
     "de": "Was machst du am Montag?",
     "tr": "Pazartesi ne yapıyorsun?",
     "en": "What do you do on Monday?"
    },
    {
     "part": "answer",
     "who": "Du",
     "de": "Ich male einen großen Mond.",
     "tr": "Büyük bir ay çiziyorum.",
     "en": "I paint a big moon."
    },
    {
     "part": "chorus",
     "who": "Alle",
     "de": "Montag, Dienstag, alle Tage!",
     "tr": "Pazartesi, salı, bütün günler!",
     "en": "Monday, Tuesday, every day!"
    },
    {
     "part": "chorus",
     "who": "Alle",
     "de": "Montag, Dienstag, alle Tage!",
     "tr": "Pazartesi, salı, bütün günler!",
     "en": "Monday, Tuesday, every day!"
    },
    {
     "part": "verse",
     "who": "Lina",
     "de": "Mittwoch fährt mein Teddy Zug.",
     "tr": "Çarşamba ayıcığım tren kullanıyor.",
     "en": "On Wednesday my teddy drives a train."
    },
    {
     "part": "call",
     "who": "Lina",
     "de": "Was machst du am Donnerstag?",
     "tr": "Perşembe ne yapıyorsun?",
     "en": "What do you do on Thursday?"
    },
    {
     "part": "answer",
     "who": "Du",
     "de": "Ich singe mit dem Teddy.",
     "tr": "Ayıcıkla şarkı söylüyorum.",
     "en": "I sing with the teddy."
    },
    {
     "part": "verse",
     "who": "Lina",
     "de": "Freitag tanzt die kleine Maus.",
     "tr": "Cuma küçük fare dans ediyor.",
     "en": "On Friday the little mouse dances."
    },
    {
     "part": "call",
     "who": "Lina",
     "de": "Was machst du am Samstag?",
     "tr": "Cumartesi ne yapıyorsun?",
     "en": "What do you do on Saturday?"
    },
    {
     "part": "answer",
     "who": "Du",
     "de": "Ich esse Käse mit der Maus.",
     "tr": "Fareyle peynir yiyorum.",
     "en": "I eat cheese with the mouse."
    },
    {
     "part": "chorus",
     "who": "Alle",
     "de": "Montag, Dienstag, alle Tage!",
     "tr": "Pazartesi, salı, bütün günler!",
     "en": "Monday, Tuesday, every day!"
    },
    {
     "part": "chorus",
     "who": "Alle",
     "de": "Montag, Dienstag, alle Tage!",
     "tr": "Pazartesi, salı, bütün günler!",
     "en": "Monday, Tuesday, every day!"
    },
    {
     "part": "verse",
     "who": "Lina",
     "de": "Sonntag schläft der Teddy ein.",
     "tr": "Pazar günü ayıcık uyuyakalıyor.",
     "en": "On Sunday the teddy falls asleep."
    },
    {
     "part": "call",
     "who": "Lina",
     "de": "Und was machst du am Sonntag?",
     "tr": "Peki pazar günü ne yapıyorsun?",
     "en": "And what do you do on Sunday?"
    },
    {
     "part": "answer",
     "who": "Du",
     "de": "Ich wecke ihn mit Musik.",
     "tr": "Onu müzikle uyandırıyorum.",
     "en": "I wake him with music."
    },
    {
     "part": "verse",
     "who": "Lina",
     "de": "Der Teddy tanzt im Schlaf.",
     "tr": "Ayıcık uykusunda dans ediyor.",
     "en": "The teddy dances in his sleep."
    },
    {
     "part": "call",
     "who": "Lina",
     "de": "Welcher Tag kommt nach Sonntag?",
     "tr": "Pazardan sonra hangi gün gelir?",
     "en": "Which day comes after Sunday?"
    },
    {
     "part": "answer",
     "who": "Du",
     "de": "Montag, noch einmal!",
     "tr": "Pazartesi, bir daha!",
     "en": "Monday, once again!"
    },
    {
     "part": "chorus",
     "who": "Alle",
     "de": "Montag, Dienstag, alle Tage!",
     "tr": "Pazartesi, salı, bütün günler!",
     "en": "Monday, Tuesday, every day!"
    },
    {
     "part": "outro",
     "who": "Lina",
     "de": "Sieben Tage, Teddy tanzt!",
     "tr": "Yedi gün, ayıcık dans ediyor!",
     "en": "Seven days, the teddy dances!"
    }
